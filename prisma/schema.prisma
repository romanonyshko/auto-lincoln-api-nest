generator client {
  provider            = "prisma-client"
  output              = "../src/db/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manager
  client
}

enum Currency {
  EUR
  USD
  UAH
}

enum RequestStatus {
  pending
  approved
  spam
  trash
}

model DashboardStat {
  id           String @id
  label        String
  value        String
  deltaPercent Int?
  order        Int

  @@map("dashboard_stats")
}

model MonthlyActivity {
  id       String   @id @default(uuid())
  month    DateTime @unique @db.Date
  visitors Int

  @@map("monthly_activity")
}

model News {
  id          String   @id @default(uuid())
  title       String
  publishedAt DateTime

  reviews Review[]

  @@map("news")
}

model Review {
  id        String   @id @default(uuid())
  newsId    String
  author    String
  text      String
  createdAt DateTime @default(now())

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId])
  @@map("reviews")
}

model Page {
  id    String @id @default(uuid())
  title String

  @@map("pages")
}

model Request {
  id        String        @id @default(uuid())
  status    RequestStatus @default(pending)
  createdAt DateTime      @default(now())

  @@map("requests")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         UserRole @default(manager)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id    String @id @default(uuid())
  title String
  image String
  order Int

  parts Part[]

  @@map("categories")
}

model Carmaker {
  id   String @id @default(uuid())
  name String @unique

  models CarModel[]

  @@map("carmakers")
}

model CarModel {
  id         String @id @default(uuid())
  carmakerId String
  name       String

  carmaker Carmaker @relation(fields: [carmakerId], references: [id], onDelete: Cascade)
  engines  Engine[]

  @@unique([carmakerId, name])
  @@map("car_models")
}

model Engine {
  id      String @id @default(uuid())
  modelId String
  name    String

  model CarModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  parts Part[]

  @@unique([modelId, name])
  @@map("engines")
}

model Part {
  id            String   @id @default(uuid())
  categoryId    String
  title         String
  articleNumber String   @unique
  brand         String
  price         Decimal  @db.Decimal(10, 2)
  currency      Currency
  inStock       Int      @default(0)
  image         String?
  createdAt     DateTime @default(now())

  category          Category @relation(fields: [categoryId], references: [id])
  // Many-to-many: engines this part fits.
  compatibleEngines Engine[]

  @@index([categoryId])
  @@map("parts")
}
