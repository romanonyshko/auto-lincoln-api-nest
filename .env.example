# HTTP port of this API. Express runs on 3001, the web app expects Nest on 3002.
PORT=3002

# The web app origin allowed to call this API with cookies (CORS).
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker compose, project "auto-lincoln"). Same DB for both APIs.
DATABASE_URL=postgresql://autolincoln:autolincoln@localhost:5432/autolincoln?schema=public

# Signs the session JWT. Must be the same in api-express and api-nest,
# so one session works on both. Generate: openssl rand -base64 48
JWT_SECRET=change-me
