# HTTP port of this API. The web app expects it on 3002.
PORT=3002

# The web app origin allowed to call this API with cookies (CORS).
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker compose, project "auto-lincoln").
DATABASE_URL=postgresql://autolincoln:autolincoln@localhost:5432/autolincoln?schema=public

# Signs the session JWT. Generate: openssl rand -base64 48
JWT_SECRET=change-me
