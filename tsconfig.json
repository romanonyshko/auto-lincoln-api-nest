{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "types": [
      "node"
    ],
    "outDir": "dist",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src",
    "prisma",
    "prisma.config.ts"
  ]
}
